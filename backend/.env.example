# Copie este arquivo para ".env" e preencha com os seus valores reais.
MONGO_URL=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=elas_em_rede_db

# Gere uma chave com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_gerada
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Em produção, troque "*" pelo endereço do seu site
CORS_ORIGINS=*
